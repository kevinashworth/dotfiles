[alias]
	aliases = config --get-regexp '^alias\\.'
	br = branch

	# BRANCHES-BY
	branches-by = "!git-branches-by.sh"

	co = checkout
	current = log --pretty=format:\"%h %ad | %s%d [%an]\" --date=short -n1
	datetag = '!git tag `date "+%Y%m%d%H%M"`'
	detail-reflog = log --walk-reflogs
	discard = checkout --
	files = show --pretty=\"format:\" --name-only
	go-next = checkout HEAD@{1}
	go-prev = checkout HEAD^1
	hist = log --pretty=format:'%h %an %Cred%ar %Cgreen%s' --date=short --decorate

	# HOLD - see https://assistant.kagi.com/chat/eff97fec-f244-4fdc-aeea-e1425da309de
	# hold = "!git-hold.sh"
	hold = "!sh -c 'git branch -m \"$1\" \"hold/$1\"' -"
	unhold = "!sh -c 'git branch -m \"hold/$1\" \"$1\"' -"

	includes = branch --contains
	last = log -n 1 -p
	lg = log --oneline --decorate --all --graph
	mine = log --pretty=format:\"[ %h ] %ad - %s%d\" --no-merges --date=short --author=kevinashworth
	pr = pull --rebase
	push-all = push --recurse-submodules=on-demand
	s = status --short
	slap = blame -w
	st = status
	stashgrep = "!f() { for i in `git stash list --format=\"%gd\"` ; do git stash show -p $i | grep -H --label=\"$i\" \"$@\" ; done ; }; f"
	state = status -sb
	today = log --pretty=format:\"* %s%d [%h]\" --no-merges --date=short --author=kevinashworth --since=\"$DATE 00:00:00\" --until=\"$DATE 24:00:00\"
	top = shortlog -s -n
	type = cat-file -t

[branch]
	sort = -committerdate

[column]
	ui = never

[commit]
	template = /Users/kevin/.stCommitMsg
	verbose = true

[core]
	editor = "code --wait $@"
	excludesfile = /Users/kevin/.gitignore_global
	pager = diff-so-fancy | less --tabs=4 -RF

[diff]
	algorithm = histogram
	colorMoved = zebra
	compactionHeuristic = true
	mnemonicPrefix = true
	renames = true
	tool = sourcetree

[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =

[fetch]
	all = true
	prune = true
	pruneTags = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[format]
	pretty = oneline

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

[interactive]
	diffFilter = diff-so-fancy --patch

[log]
	abbrevCommit = true
	date = relative
	decorate = short
	pretty = oneline

[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true

[push]
	autoSetupRemote = true
	default = simple
	followTags = true

[rebase]
	autoSquash = true

[tag]
	sort = version:refname

[ui]
	color = auto

[user]
	email = 1218844+kevinashworth@users.noreply.github.com
	name = Kevin Ashworth
